&НаКлиенте
Функция ОбработатьПакеты(Параметры)
	
	МассивДанныхПакетов = Параметры.МассивДанныхПакетов;
	
	КоличествоСтрок = МассивДанныхПакетов.Количество();
	
	Для А = 0  По КоличествоСтрок - 1 Цикл
		Состояние("Обработка пакетов...", Окр(100 * А / КоличествоСтрок)); 
		
		ДанныеПакета = МассивДанныхПакетов[А];
		
		Если НЕ ЗначениеЗаполнено(ДанныеПакета.СпособОбработки) Тогда
			Сообщить("Невозможно обработать пакет с идентификатором """+ДанныеПакета.ИдентификаторПакета+""", т.к. в нем не выбран способ обработки пакета!");
			Продолжить;
		КонецЕсли;
		
		ОбработатьПакетНаСервере(ДанныеПакета.ИдентификаторПакета, ДанныеПакета.СпособОбработки);
		
	КонецЦикла;
	
	Состояние("Обработка пакетов...", 100);
	
КонецФункции

&НаСервере
Процедура ОбработатьПакетНаСервере(ИдентификаторПакета, СпособОбработки)
	ПараметрыСпособаОбработки = ум_ПакетыДанныхОбщегоНазначения.ПолучитьПараметрыСпособаОбработки(СпособОбработки);
	ПараметрыСпособаОбработки.Вставить("ОбработкаПакетаВСеансеКлиента", Истина);
		
	МассивИдентификаторов = Новый Массив;
	МассивИдентификаторов.Добавить(ИдентификаторПакета);
	ум_ПакетыДанныхОбработка.ОбработчикРабочегоФЗ(МассивИдентификаторов, ПараметрыСпособаОбработки);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПакетыКоманда_Продолжение(Результат, ДопПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьПакеты(ДопПараметры);
	Оповестить("ум_ОбновитьФормуСпискаПакетов");
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивСтруктурПоТаблице(ТаблицаЗначений)
	
	МассивСтруктур = Новый Массив;
	Для каждого СтрТаблицы из ТаблицаЗначений Цикл 
		
		СтруктураСтроки = Новый Структура;
		Для каждого КолонкаТаблицы из ТаблицаЗначений.Колонки Цикл
			СтруктураСтроки.Вставить(КолонкаТаблицы.Имя, СтрТаблицы[КолонкаТаблицы.Имя]);
		КонецЦикла;
		
		МассивСтруктур.Добавить(СтруктураСтроки);
		
	КонецЦикла;
	
	Возврат МассивСтруктур;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеВыделенныхСтрокПакетов()
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Если ум_ОбщегоНазначенияКлиентСервер.СравнитьВерсии(СистемнаяИнформация.ВерсияПриложения, "8.5.1.0") > 0 Тогда
		МассивВыделенныхСтрок = Элементы.СписокИзменяемыхПакетов.ПолучитьСтрокиДляОбработки();
	Иначе
		МассивВыделенныхСтрок = Элементы.СписокИзменяемыхПакетов.ВыделенныеСтроки;
	КонецЕсли;
	
	МассивИдентификаторовПакетов = Новый Массив;
	Для каждого КлючСтроки Из МассивВыделенныхСтрок Цикл
		МассивИдентификаторовПакетов.Добавить(КлючСтроки.ИдентификаторПакета);
	КонецЦикла;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ум_ПакетыДанных.ИдентификаторПакета,
	|	ум_ПакетыДанных.КлючАналитикиПакетаДанных.СпособОбработкиПакетов КАК СпособОбработки,
	|	ум_ПакетыДанных.ДатаСозданияПакета КАК ДатаСозданияПакета
	|ИЗ
	|	РегистрСведений.ум_ПакетыДанных КАК ум_ПакетыДанных
	|ГДЕ
	|	ум_ПакетыДанных.ИдентификаторПакета В(&МассивИдентификаторов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ум_ПакетыДанных.ДатаСозданияПакета";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("МассивИдентификаторов",  МассивИдентификаторовПакетов);
	
	ТаблицаПакетов = Запрос.Выполнить().Выгрузить();
	
	МассивДанныхПакетов = ПолучитьМассивСтруктурПоТаблице(ТаблицаПакетов);
	
	Возврат МассивДанныхПакетов;
	
КонецФункции

#КонецОбласти // Обработка_Пакетов_Онлайн

&НаСервереБезКонтекста
Функция ПолучитьДанныеПакетаВХранилище(ИдентификаторПакета, ИдентификаторФормы = Неопределено) Экспорт
	Данные = ум_ПакетыДанныхОбщегоНазначения.ПолучитьДанныеПакета(ИдентификаторПакета);
	АдресХранилища = ПоместитьВоВременноеХранилище(Данные, ИдентификаторФормы);
	Возврат АдресХранилища;
КонецФункции

&НаСервере
Функция СоздатьПакетДанных(Данные, СпособОбработки, ДатаСледующейОбработкиПакета, ДополнительнаяИнформация = "", Комментарий = "") Экспорт
		Результат = ум_ПакетыДанных.СоздатьПакетДанных(	Данные,
														СпособОбработки,
														ДатаСледующейОбработкиПакета,
														ДополнительнаяИнформация,
														Комментарий
		);
		Возврат Результат;
КонецФункции

&НаКлиенте
Функция СформироватьТекстОписания()
	
	ТекстОписания = "";
	
	Если УдалитьПакеты Тогда
		ТекстОписания = ТекстОписания + ?(ЗначениеЗаполнено(ТекстОписания), " / ", "") + " удаление пакетов";
		Возврат ТекстОписания;
	КонецЕсли;
	
	Если ИзменитьДатуСледующейОбработки Тогда
		ТекстОписания = ТекстОписания + ?(ЗначениеЗаполнено(ТекстОписания), " / ", "") + "дата сл. обр. = " + ДатаСледующейОбработки;
	КонецЕсли;
	Если ИзменитьКоличествоПопытокОбработки Тогда
		ТекстОписания = ТекстОписания + ?(ЗначениеЗаполнено(ТекстОписания), " / ", "") + "кол. попыток = " + КоличествоПопытокОбработки;
	КонецЕсли;
	Если ИзменитьПакетПрипаркован Тогда
		ТекстОписания = ТекстОписания + ?(ЗначениеЗаполнено(ТекстОписания), " / ", "") + "припаркован = " + ПакетПрипаркован;
	КонецЕсли;
	Если ИзменитьСостояние Тогда
		ТекстОписания = ТекстОписания + ?(ЗначениеЗаполнено(ТекстОписания), " / ", "") + "состояние = " + Состояние;
	КонецЕсли;
	Если ИзменитьСпособОбработки Тогда
		ТекстОписания = ТекстОписания + ?(ЗначениеЗаполнено(ТекстОписания), " / ", "") + "способ обработки = " + СпособОбработки;
	КонецЕсли;
		
	Возврат ТекстОписания;
	
КонецФункции

#КонецОбласти // СлужебныеПроцедурыИФункции
