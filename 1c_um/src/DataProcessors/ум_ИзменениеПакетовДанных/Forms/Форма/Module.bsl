#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаИзменитьПакетыОффлайн(Команда)
	
	Если Не УдалитьПакеты И Не ИзменитьСостояние И Не ИзменитьСпособОбработки И Не ИзменитьПакетПрипаркован И
		Не ИзменитьКоличествоПопытокОбработки И Не ИзменитьДатуСледующейОбработки Тогда
		ПоказатьПредупреждение(, "Не выбрано действие с пакетами!", , "Не выбрано действие");
		Возврат;
	КонецЕсли;
	
	Если НЕ УдалитьПакеты И ИзменитьСостояние и Не ЗначениеЗаполнено(Состояние) Тогда
		ПоказатьПредупреждение(, "Не заполнено новое состояние пакетов данных!", , "Не заполнены реквизиты");
		Возврат;
	КонецЕсли;
	
	Если НЕ УдалитьПакеты И ИзменитьСпособОбработки и Не ЗначениеЗаполнено(СпособОбработки) Тогда
		ПоказатьПредупреждение(, "Не заполнен новый способ оюбработки пакетов!", , "Не заполнены реквизиты");
		Возврат;
	КонецЕсли;
	
	ДействияВыбраны = Ложь; 
	ТестДиалогаПодтверждения = "Выполнить действия:";
	Если УдалитьПакеты Тогда
		ДействияВыбраны = Истина;
		ТестДиалогаПодтверждения = ТестДиалогаПодтверждения + Символы.ПС + " - Удалить пакеты " + """";
	Иначе
		Если ИзменитьСостояние Тогда
			ДействияВыбраны = Истина;
			ТестДиалогаПодтверждения = ТестДиалогаПодтверждения + Символы.ПС + " - Изменить состояние - """ + Состояние + """";
		КонецЕсли;
		Если ИзменитьСпособОбработки Тогда
			ДействияВыбраны = Истина;
			ТестДиалогаПодтверждения = ТестДиалогаПодтверждения + Символы.ПС + " - Изменить способ обработки - """ + СпособОбработки + """";
		КонецЕсли;
		Если ИзменитьКоличествоПопытокОбработки Тогда
			ДействияВыбраны = Истина;
			ТестДиалогаПодтверждения = ТестДиалогаПодтверждения + Символы.ПС + " - Изменить Количество попыток обработки - " + КоличествоПопытокОбработки;
		КонецЕсли;
		Если ИзменитьДатуСледующейобработки Тогда
			//ДействияВыбраны = Истина;
			ТестДиалогаПодтверждения = ТестДиалогаПодтверждения + Символы.ПС + " - Изменить дату следующей обработки - " + ДатаСледующейОбработки;
		КонецЕсли;
		Если ИзменитьПакетПрипаркован Тогда
			ДействияВыбраны = Истина;
			ТестДиалогаПодтверждения = ТестДиалогаПодтверждения + Символы.ПС + " - Изменить пакет припаркован - """ + ПакетПрипаркован + """";
		КонецЕсли;
	КонецЕсли;
	
	МассивИдентификаторов = ПолучитьСписокПакетовДляИзменения();
	Если НЕ МассивИдентификаторов.Количество() Тогда
		Сообщить("Нет элементов для обработки!");
		Возврат;
	КонецЕсли;
	
	ТестДиалогаПодтверждения = ТестДиалогаПодтверждения + "?" + Символы.ПС + "Количество пакетов: " + МассивИдентификаторов.Количество();
	
	ДополнительныеПараметры = Новый Структура("МассивИдентификаторов", МассивИдентификаторов);
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаИзменитьПакетыОффлайн", ЭтаФорма, ДополнительныеПараметры);
	ПоказатьВопрос(Оповещение, ТестДиалогаПодтверждения, РежимДиалогаВопрос.ДаНетОтмена, 0, КодВозвратаДиалога.Отмена, "Изменение пакетов?");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбработатьПакеты(Команда)
	
	МассивДанныхПакетов = ПолучитьДанныеВыделенныхСтрокПакетов();
	
	Если Не ЗначениеЗаполнено(МассивДанныхПакетов) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = "Обработать " + Строка(МассивДанныхПакетов.Количество()) + " пакета(-ов)?";
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("МассивДанныхПакетов", МассивДанныхПакетов);
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьПакетыКоманда_Продолжение",  ЭтаФорма, ДополнительныеПараметры);	 	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена, 0, КодВозвратаДиалога.Отмена, "Пакеты обработки");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОткрытьДанныеПакета(Команда)
	
	ТекущиеДанные = Элементы.СписокИзменяемыхПакетов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АдресХранилищаДанных = ПолучитьДанныеПакетаВХранилище(ТекущиеДанные.ИдентификаторПакета);
	ПараметрыФормы = Новый Структура("АдресХранилищаДанных", АдресХранилищаДанных);
	ТекстЗаголовка = СтрШаблон("Данные пакета: %1", Строка(ТекущиеДанные.ИдентификаторПакета));
	ПараметрыФормы.Вставить("Заголовок", ТекстЗаголовка);
	ОткрытьФорму("ОбщаяФорма.ум_ФормаПросмотраДанных",
				 ПараметрыФормы,
				 ЭтаФорма,
				 УникальныйИдентификатор,
				 ,
				 ,
				 ,
				 РежимБлокировкиПриОткрытииОкнаФормы.НеБлокировать
	);
КонецПроцедуры

