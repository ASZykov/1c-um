&НаСервере
Функция ПолучитьСписокПакетовДляИзменения()
	
	Схема		 = Элементы.СписокИзменяемыхПакетов.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки	 = Элементы.СписокИзменяемыхПакетов.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	КомпоновщикМакета	= Новый КомпоновщикМакетаКомпоновкиДанных();
	МакетКомпоновки		= КомпоновщикМакета.Выполнить(Схема, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки	= новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	ПроцессорВывода		= новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	ВсегоСтрок = Результат.Количество();
	Для Итер = 1 по ВсегоСтрок Цикл
		ТекСтрока = Результат[ВсегоСтрок - Итер];
		Если ТекСтрока.ИдентификаторПакета = "" ИЛИ ТекСтрока.ИдентификаторПакета = Неопределено Тогда
			Результат.Удалить(ТекСтрока);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат.ВыгрузитьКолонку("ИдентификаторПакета");
	
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияВопросаИзменитьПакетыОффлайн(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	РазмерПакета = РазмерСоздаваемогоПакета;
	ТекстОписания = "Действия: ";
	Разделитель = "";
	
	ОписаниеДействий = Новый Структура();
	
	Если УдалитьПакеты Тогда
		
		ОписаниеДействий.Вставить("УдалитьПакеты", УдалитьПакеты);
		
	Иначе
		
		ОписаниеДействий.Вставить("ИзменитьСостояние"	, ИзменитьСостояние);
		ОписаниеДействий.Вставить("Состояние"			, Состояние);
		
		ОписаниеДействий.Вставить("ИзменитьСпособОбработки"	, ИзменитьСпособОбработки);
		ОписаниеДействий.Вставить("СпособОбработки"			, СпособОбработки);
		
		ОписаниеДействий.Вставить("ИзменитьКоличествоПопытокОбработки"	, ИзменитьКоличествоПопытокОбработки);
		ОписаниеДействий.Вставить("КоличествоПопытокОбработки"			, КоличествоПопытокОбработки);
		
		ОписаниеДействий.Вставить("ИзменитьДатуСледующейобработки"	, ИзменитьДатуСледующейОбработки);
		ОписаниеДействий.Вставить("ДатаСледующейОбработки"			, ДатаСледующейОбработки);
		
		ОписаниеДействий.Вставить("ИзменитьПакетПрипаркован"	, ИзменитьПакетПрипаркован);
		ОписаниеДействий.Вставить("ПакетПрипаркован"			, ПакетПрипаркован);
		
	КонецЕсли;
	
	Если ОписаниеДействий.Количество() = 0 Тогда
		Сообщить("Не указаны действия с пакетом!");
		Возврат;
	КонецЕсли;
	
	ТекстОписания = СформироватьТекстОписания();
	
	ИдентификаторЗадания = СформироватьФоновоеЗаданиеНаФормированиеПакетов(	ДополнительныеПараметры.МассивИдентификаторов,
																			ОписаниеДействий,
																			ТекстОписания,
																			РазмерПакета
	);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИдентификаторЗадания", ИдентификаторЗадания);
	ПараметрыФормы.Вставить("АвтоЗакрытие", Истина);
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияФормыСозданияПакетовДанных", ЭтотОбъект, Неопределено);
	
	ОткрытьФорму("ОбщаяФорма.ум_ФормаПрогрессБар",
				 ПараметрыФормы,
				 ЭтаФорма,
				 УникальныйИдентификатор,
				 ,
				 ,
				 Оповещение,
				 РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца
	);
	
КонецПроцедуры

&НаСервере
Функция СформироватьФоновоеЗаданиеНаФормированиеПакетов(МассивИдентификаторов, ОписаниеДействий, ТекстОписания, РазмерПакета)
	Перем ДанныеРасшифровки;
	
	ИмяПроцедуры = "ум_ИзменениеПакетовДанных.СоздатьПакетыМногопоточноеИзменениеПакетовДанных";
	ПараметрыПроцедуры = Новый Массив;
	ПараметрыПроцедуры.Добавить(МассивИдентификаторов);
	ПараметрыПроцедуры.Добавить(ОписаниеДействий);
	ПараметрыПроцедуры.Добавить(ТекстОписания);
	ПараметрыПроцедуры.Добавить(РазмерПакета);
	
	Задание = ФоновыеЗадания.Выполнить(ИмяПроцедуры, ПараметрыПроцедуры, , "ум_ИзменениеПакетовДанных");
	ИдентификаторЗадания = Задание.УникальныйИдентификатор;
	
	Возврат ИдентификаторЗадания;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьДоступностьРеквизитов()
	
	Элементы.ИзменитьСостояние.Доступность					= НЕ УдалитьПакеты;
	Элементы.ИзменитьСпособОбработки.Доступность 			= НЕ УдалитьПакеты;
	Элементы.ИзменитьДатуСледующейОбработки.Доступность 	= НЕ УдалитьПакеты;
	Элементы.ИзменитьКоличествоПопытокОбработки.Доступность	= НЕ УдалитьПакеты;
	Элементы.ИзменитьПакетПрипаркован.Доступность 			= НЕ УдалитьПакеты;
	
	Элементы.Состояние.Доступность			 		= ИзменитьСостояние и НЕ УдалитьПакеты;
	Элементы.СпособОбработки.Доступность 			= ИзменитьСпособОбработки и НЕ УдалитьПакеты;
	Элементы.ДатаСледующейОбработки.Доступность 	= ИзменитьДатуСледующейОбработки и НЕ УдалитьПакеты;
	Элементы.КоличествоПопытокОбработки.Доступность = ИзменитьКоличествоПопытокОбработки и НЕ УдалитьПакеты;
	Элементы.ПакетПрипаркован.Доступность 			= ИзменитьПакетПрипаркован и НЕ УдалитьПакеты;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыСозданияПакетовДанных(Результат, ДопПараметры) Экспорт
	
