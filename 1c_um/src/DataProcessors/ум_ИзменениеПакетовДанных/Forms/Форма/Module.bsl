	Элемент.Использование = Ложь;
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("КлючАналитикиПакетаДанных.СпособОбработкиПакетов");
	
	РазмерСоздаваемогоПакета = 100;
	
КонецПроцедуры

