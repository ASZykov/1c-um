#Область СлужебныеПроцедурыИФункции

Процедура ОтобразитьДанныеНаФорму(ДанныеДляОтображения)
	
	Если ТипЗнч(ДанныеДляОтображения) = Тип("ХранилищеЗначения") Тогда
		Данные = ДанныеДляОтображения.Получить();
	Иначе
		Данные = ДанныеДляОтображения;
	КонецЕсли;
	
	ТипЗнч = ТипЗнч(Данные);
	Если ТипЗнч = Тип("Массив") Тогда
		ОтобразитьДанныеКакМассив(Данные);
	ИначеЕсли ТипЗнч = Тип("Структура") Тогда
		ОтобразитьДанныеКакСтруктура(Данные);
	ИначеЕсли ТипЗнч = Тип("Соответствие") Тогда
		ОтобразитьДанныеКакСоответствие(Данные);
	ИначеЕсли ТипЗнч = Тип("ТабличныйДокумент") Тогда
		ОтобразитьДанныеКакТабличныйДокумент(Данные);
	ИначеЕсли ТипЗнч = Тип("ТаблицаЗначений") Тогда
		ОтобразитьДанныеКакТаблицаЗначений(Данные);
	ИначеЕсли ТипЗнч = Тип("ДеревоЗначений") Тогда
		ОтобразитьДанныеКакДерево(Данные);
	ИначеЕсли ум_БСП_ОбщегоНазначения.ЭтоСсылка(ТипЗнч) Тогда 
		ОтобразитьДанныеКакСсылка(Данные);
	Иначе
		ОтобразитьДанныеКакТекст(Данные);
	КонецЕсли;
	
КонецПроцедуры // ОтобразитьДанныеНаФорму()

&НаСервере
Функция ОтобразитьДанныеКакМассив(Данные)
	
	ОтобразитьКоллекциюНаФорме(Данные);
	ТипДанных = "Массив";
	
	Возврат Истина;
	
КонецФункции // ОтобразитьДанныеКакМассив()

