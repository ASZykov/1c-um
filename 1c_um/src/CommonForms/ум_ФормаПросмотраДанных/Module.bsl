
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Перем Данные, АдресХранилищаДанных, ТекстЗаголовка;
	
	// 1. Устанавлимаем заголовок
	Параметры.Свойство("Заголовок", ТекстЗаголовка);
	Если ЗначениеЗаполнено(ТекстЗаголовка) Тогда
		Заголовок = ТекстЗаголовка;
	КонецЕсли;
	
	// 2. Получаем данные из параметра
	Если Параметры.Свойство("АдресХранилищаДанных", АдресХранилищаДанных) Тогда	
		Данные = ПолучитьИзВременногоХранилища(АдресХранилищаДанных);
		УдалитьИзВременногоХранилища(АдресХранилищаДанных);
	Иначе
		Параметры.Свойство("Данные", Данные);
	КонецЕсли;
	
	// 3. Отображаем данные на форме
	ОтобразитьДанныеНаФорму(Данные);
	
	// 4. устанавливеим начальную видимости / доступности элемнтов
	ИнициализацияВидимостиДоступностиЭлемнтовФормы();
	
КонецПроцедуры

#КонецОбласти

